# DataObs environment variables
# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored and must NEVER be committed.

# ── Elasticsearch ────────────────────────────────────────────────────────────
# Optional Elastic Stack image tag for local Docker Compose.
ELK_VERSION=9.4.2

# Password for the built-in 'elastic' superuser.
# Must be at least 6 characters. No default is provided — the stack will
# refuse to start without it.
ELASTIC_PASSWORD=

# ── Kibana ───────────────────────────────────────────────────────────────────
# Password for the built-in 'kibana_system' service account.
# Must be set. The es-setup init container automatically calls the ES security
# API to apply this password before Kibana starts, so no manual curl step is
# needed. Just set a value here and docker compose up will handle the rest.
KIBANA_PASSWORD=

# ── OTLP CORS (optional) ────────────────────────────────────────────────────
# Restrict OTLP HTTP receiver to a specific origin. Set to your internal domain.
# Leave blank to use the secure default in config/otel-collector-config.yaml.
# DO NOT set to "*" in any environment.
# OTLP_ALLOWED_ORIGINS=https://*.dataobs.internal

# ── AWS (optional — only needed for cloud pipeline observability) ────────────
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Optional overrides ───────────────────────────────────────────────────────
# DATAOBS_CONFIG=./config/dataobs.yaml
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# DEPLOY_ENV=local
# DATAOBS_VERSION=dev
