# Copy to .env.mvp and replace both values before starting the MVP stack.
# The real file is ignored by Git. Do not reuse these example values.
ELASTIC_PASSWORD=replace-with-a-local-elasticsearch-password
DATAOBS_API_TOKEN=replace-with-a-local-api-token

# Pinned product/runtime versions.
ELASTICSEARCH_VERSION=9.4.2
DATAOBS_VERSION=0.2.0

