# ============================================================
#  DataObs — POC Environment Variables
#  Copy this file → .env.poc.local and fill in real values.
#  .env.poc.local is gitignored and must NEVER be committed.
#
#  Usage:
#    docker compose -f docker-compose.poc.yml --env-file .env.poc up -d
# ============================================================

# ── Elasticsearch ────────────────────────────────────────────
# Password for the built-in 'elastic' superuser.
# Minimum 6 characters. Stack refuses to start if blank.
ELASTIC_PASSWORD=dataobs_poc_secret

# Elasticsearch HTTP URL used by the pipeline & Kibana.
ELASTICHOST=http://elasticsearch:9200

# ── Kibana ───────────────────────────────────────────────────
# Password for the 'kibana_system' service account.
# The es-setup init container applies this automatically.
KIBANA_PASSWORD=kibana_poc_secret

# Kibana public URL (used by bootstrap_kibana.py).
KIBANA_URL=http://localhost:5601

# ── OpenTelemetry Collector ──────────────────────────────────
# OTLP HTTP endpoint the pipeline sends traces/metrics to.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ── DataObs Pipeline ─────────────────────────────────────────
# Path to the POC-specific config file (mounted into the container).
DATAOBS_CONFIG=./config/dataobs_poc.yaml

# Tenant identifier used to namespace Elasticsearch indices.
DATAOBS_TENANT_ID=poc

# Storage backend: 'elasticsearch' or 'memory'.
DATAOBS_STORE_BACKEND=elasticsearch

# ── Spark ────────────────────────────────────────────────────
# Spark master URL.  'local[*]' runs entirely inside the pipeline container.
SPARK_MASTER=local[*]

# ── Stack versions (keep in sync with docker-compose.poc.yml) ─
ELK_VERSION=8.13.4

# ── AWS (optional) ───────────────────────────────────────────
# Only needed if you point the POC at an AWS OpenSearch endpoint
# or want to test cloud pipeline observability.
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
