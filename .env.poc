# ============================================================
#  DataObs POC — Environment Variables
#  Copy to .env.poc.local and adjust before starting
# ============================================================

# ── Elastic Stack ─────────────────────────────────────────────
ELK_VERSION=9.3.3
ELASTIC_PASSWORD=dataobs_poc_elastic
KIBANA_PASSWORD=dataobs_poc_kibana

# ── APM ───────────────────────────────────────────────────────
APM_SECRET_TOKEN=dataobs_poc_apm_token
# APM_SERVER_URL is the elastic-agent service name + port.
# The otel-collector-poc.yaml prepends http:// so this must be host:port only.
APM_SERVER_URL=elastic-agent:8200

# ── Elasticsearch (direct OTel export) ────────────────────────
# Used by the OTel elasticsearch exporter to write traces/metrics/logs
# directly to ES (in addition to APM) so data is visible in Kibana Discover.
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICHOST=http://elasticsearch:9200

# ── OpenTelemetry ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=dataobs-pipeline
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=poc,service.namespace=dataobs

# ── Spark ─────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_SUBMIT_OPTS=-Dotel.service.name=spark-driver -Dotel.exporter.otlp.endpoint=http://otel-collector:4318 -Dotel.exporter.otlp.protocol=http/protobuf -Dotel.traces.exporter=otlp -Dotel.metrics.exporter=otlp -Dotel.logs.exporter=otlp -Dotel.resource.attributes=deployment.environment=poc,service.namespace=dataobs

# ── Docker monitoring ─────────────────────────────────────────
# cAdvisor runs on port 8081 (mapped from container 8080)
# OTel Collector scrapes cAdvisor at http://cadvisor:8080 (internal Docker network)
# Elastic Agent also collects Docker metrics via Docker integration (Fleet)
CADVISOR_PORT=8081
# Docker socket path (used by elastic-agent Docker integration + OTel docker_stats)
DOCKER_SOCKET=/var/run/docker.sock

# ── Cloud resource attributes ─────────────────────────────────
# These are injected into every OTel signal via resource/cloud processor.
# Set CLOUD_PROVIDER=aws + CLOUD_REGION=<region> when running on AWS.
# For local POC, keep as-is — empty values caused collector errors previously.
CLOUD_PROVIDER=local
CLOUD_REGION=local
HOST_NAME=dataobs-poc-host

# ── Pipeline ──────────────────────────────────────────────────
DEPLOYMENT_ENV=poc
DATAOBS_TENANT_ID=poc
DATAOBS_STORE_BACKEND=elasticsearch
