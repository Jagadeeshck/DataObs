# ============================================================
#  DataObs POC — Environment Variables (committed template)
#
#  This file holds safe POC defaults and is the single source
#  of truth for the variables docker-compose.poc.yml expects.
#
#  Default workflow (use this file directly):
#    docker compose -f docker-compose.poc.yml --env-file .env.poc up -d
#
#  Optional local override (only if you need custom passwords/regions):
#    cp .env.poc .env.poc.local       # gitignored, never committed
#    # edit .env.poc.local, then run with that file:
#    docker compose -f docker-compose.poc.yml \
#      --env-file .env.poc.local up -d
#
#  IMPORTANT: if you keep a `.env.poc.local` from an older checkout,
#  make sure it stays in sync with this template — stale local
#  overrides (e.g. ELASTIC_APM_SERVER_URL or OTEL_SDK_DISABLED) are
#  the most common cause of broken POC runs.
#
#  Defaults below are intentionally non-secret POC placeholders.
#  Never commit real credentials here.
# ============================================================

# ── Elastic Stack ─────────────────────────────────────────────
# Latest Elastic Stack — drives every Elastic image in the compose file.
ELK_VERSION=9.4.0
ELASTIC_PASSWORD=dataobs_poc_elastic
KIBANA_PASSWORD=dataobs_poc_kibana

# ── Elasticsearch (single-node POC sizing) ────────────────────
# JVM heap and Docker memory limit. Defaults fit a 4-6 GB laptop.
ES_HEAP=1g
ES_MEM_LIMIT=2g

# ── Elastic APM (default telemetry path) ──────────────────────
# The Elastic APM Python agent ships traces/spans, custom metrics and
# log correlation directly to the APM Server hosted by the Fleet-managed
# elastic-agent container. No standalone OpenTelemetry Collector is
# required — the OTel SDK is disabled in the pipeline by default.
APM_SECRET_TOKEN=dataobs_poc_apm_token
ELASTIC_APM_SERVER_URL=http://elastic-agent:8200
# Bare host:port retained for the optional `--profile otel` mode where
# the standalone OTel Collector forwards to the same APM Server.
APM_SERVER_URL=elastic-agent:8200

# ── Elasticsearch (direct ES indexing for raw/curated/dataobs docs) ──
# The pipeline bulk-indexes pipeline records and dataobs-* observability
# documents straight into Elasticsearch. APM telemetry follows the APM
# Server route above.
# Single-node POC cluster (discovery.type=single-node, ES 9.4.0).
# Production / AWS reference architecture is multi-node with transport TLS;
# see docs/poc-setup.md for the upgrade path.
ELASTICSEARCH_URL=http://es01:9200
ELASTICHOST=http://es01:9200

# ── OpenTelemetry SDK (disabled in default POC path) ──────────
# Set to "false" only when running with `docker compose --profile otel up -d`
# AND you want the pipeline to also emit OTLP to the standalone collector.
OTEL_SDK_DISABLED=true

# ── Spark ─────────────────────────────────────────────────────
SPARK_MASTER=local[*]

# ── Docker monitoring (Elastic Agent Docker integration) ──────
# Container metrics + logs are collected by the Elastic Agent Docker
# integration (Fleet) into .ds-metrics-docker.* and .ds-logs-docker.*.
# cAdvisor remains exposed for the optional otel profile.
CADVISOR_PORT=8081
DOCKER_SOCKET=/var/run/docker.sock

# ── Cloud resource attributes (used by the optional otel profile) ──
CLOUD_PROVIDER=local
CLOUD_REGION=local
HOST_NAME=dataobs-poc-host

# ── Pipeline ──────────────────────────────────────────────────
DEPLOYMENT_ENV=poc
DATAOBS_TENANT_ID=poc
DATAOBS_STORE_BACKEND=elasticsearch
