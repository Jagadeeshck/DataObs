# ============================================================
#  DataObs — POC Environment Variables
#  Copy this file to .env.poc.local and fill in real values.
#  .env.poc.local is gitignored and must NEVER be committed.
#
#  Usage:
#    cp .env.poc .env.poc.local
#    docker compose -f docker-compose.poc.yml --env-file .env.poc.local up -d
# ============================================================

# ── Elastic Stack version ────────────────────────────────────
# Latest stable Elastic 9.4.x. APM Server is built into Elastic Agent
# in 9.x — no separate apm-server container is needed.
ELK_VERSION=9.4.0

# ── Elasticsearch (3-node cluster sizing) ────────────────────
# Per-node JVM heap (Xms/Xmx) and Docker memory limit.
ES_HEAP=1g
ES_MEM_LIMIT=2g

# ── Elasticsearch ────────────────────────────────────────────
# Password for the built-in 'elastic' superuser.
# Minimum 6 characters. Stack refuses to start if blank.
ELASTIC_PASSWORD=dataobs_poc_secret

# Elasticsearch HTTP URL used by the pipeline & Kibana.
ELASTICHOST=http://localhost:9200

# ── Kibana ───────────────────────────────────────────────────
# Password for the built-in 'kibana_system' service account.
KIBANA_PASSWORD=kibana_poc_secret

# Kibana public URL (used by bootstrap_kibana.py and Elastic Agent).
KIBANA_URL=http://localhost:5601

# ── Fleet / Elastic Agent (APM) ──────────────────────────────
# In Elastic Stack 9.x, APM Server runs inside Elastic Agent,
# coordinated by Fleet Server. No separate apm-server image.
#
# Fleet enrollment token is auto-generated by the es-setup
# init container and written to a shared Docker volume.
# Leave FLEET_ENROLLMENT_TOKEN blank — it is set automatically.
FLEET_SERVER_HOST=http://localhost:8220
FLEET_ENROLLMENT_TOKEN=

# APM Server endpoint exposed by Elastic Agent (port 8200).
# The OTel Collector forwards traces here via OTLP/gRPC.
APM_SERVER_URL=http://localhost:8200

# Secret token for APM intake authentication.
APM_SECRET_TOKEN=dataobs_poc_apm_token

# ── OpenTelemetry Collector ───────────────────────────────────
# OTLP HTTP endpoint the pipeline sends traces/metrics/logs to.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ── DataObs Pipeline ─────────────────────────────────────────
DATAOBS_CONFIG=./config/dataobs_poc.yaml
DATAOBS_TENANT_ID=poc
DATAOBS_STORE_BACKEND=elasticsearch
SPARK_MASTER=local[*]

# ── AWS (optional) ───────────────────────────────────────────
# Only required when pointing the POC at AWS OpenSearch.
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
