# ── Secrets and local config ─────────────────────────────────────────────────
# NEVER commit real credentials or local config overrides.
# Committed templates: .env.example, .env.poc (safe POC defaults only).
# Local overrides (always gitignored):
#   .env                   — top-level local
#   .env.local             — top-level local override
#   .env.*.local           — per-stack local override (e.g. .env.poc.local)
.env
.env.local
.env.*.local
*.env
config/dataobs.yaml
certification/runtime-secrets/*
!certification/runtime-secrets/.gitkeep

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.Python
pip-wheel-metadata/
*.egg

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage/
coverage-*/
test-results/
playwright-report/
.playwright/
**/.cache/ms-playwright/

# JavaScript dependencies and reproducible build output. Lockfiles remain tracked.
node_modules/
**/node_modules/
ui/dataobs-console/.vite/
ui/dataobs-console/coverage/
ui/dataobs-console/dist/
ui/dataobs-console/test-results/
ui/dataobs-console/playwright-report/

# ── Type checking ────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
.pyright/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Docker ───────────────────────────────────────────────────────────────────
*.log

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
