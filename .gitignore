# ── Secrets and local config ─────────────────────────────────────────────────
# NEVER commit real credentials or local config overrides.
# Committed templates: .env.example, .env.poc (safe POC defaults only).
# Local overrides (always gitignored):
#   .env                   — top-level local
#   .env.local             — top-level local override
#   .env.*.local           — per-stack local override (e.g. .env.poc.local)
.env
.env.local
.env.*.local
*.env
config/dataobs.yaml

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.Python
pip-wheel-metadata/
*.egg

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type checking ────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
.pyright/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Docker ───────────────────────────────────────────────────────────────────
*.log

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
