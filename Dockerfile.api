# syntax=docker/dockerfile:1
# — Stage 1: build deps —————————————————————————————————————————
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build tools only in builder stage
RUN apt-get update && apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install --upgrade "setuptools>=70.0.0" "wheel>=0.46.2" "jaraco.context>=6.1.0"
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# — Stage 2: runtime —————————————————————————————————————————
FROM python:3.11-slim AS runtime

LABEL org.opencontainers.image.title="DataObs API"
LABEL org.opencontainers.image.description="DataObs lightweight REST API for rule and lineage management"

WORKDIR /app

# Upgrade base-image bundled setuptools/wheel/jaraco.context in place to remediate
# Trivy CVE-2026-23949 (jaraco.context) and CVE-2026-24049 (wheel). pip handles
# removal of the old dist-info/RECORD entries so no orphaned vulnerable metadata remains.
RUN pip install --no-cache-dir --upgrade "setuptools>=70.0.0" "wheel>=0.46.2" "jaraco.context>=6.1.0"

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source and shared packages
COPY src ./src
COPY packages ./packages
COPY services ./services
COPY config ./config

# Non-root user for security
RUN addgroup --system dataobs && adduser --system --ingroup dataobs dataobs
USER dataobs

EXPOSE 8080

# Healthcheck against the /health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')"

CMD ["python", "-m", "src.api.main"]
