FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --no-create-home dataobs
COPY packages packages
COPY services services
COPY src src
USER 10001
ENTRYPOINT ["python", "-m", "services.monitor_runtime.cli"]
CMD ["run"]
