FROM python:3.11-slim
WORKDIR /app

# Upgrade base-image bundled setuptools/wheel/jaraco.context in place to remediate
# Trivy CVE-2026-23949 (jaraco.context) and CVE-2026-24049 (wheel). pip handles
# removal of the old dist-info/RECORD entries so no orphaned vulnerable metadata remains.
RUN pip install --no-cache-dir --upgrade "setuptools>=70.0.0" "wheel>=0.46.2" "jaraco.context>=6.1.0"

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY packages packages
COPY services services
COPY config config

# Non-root user for security
RUN addgroup --system dataobs && adduser --system --ingroup dataobs dataobs
USER dataobs

ENTRYPOINT ["python", "-m", "services.pathway_worker.cli"]
CMD ["run"]
