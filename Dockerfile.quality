# syntax=docker/dockerfile:1
# ── Stage 1: build deps ───────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

LABEL org.opencontainers.image.title="DataObs Quality Engine"
LABEL org.opencontainers.image.description="DataObs data quality, freshness, and lineage monitoring engine"

WORKDIR /app

COPY --from=builder /install /usr/local

COPY src ./src
COPY config ./config

RUN addgroup --system dataobs && adduser --system --ingroup dataobs dataobs
USER dataobs

# Quality engine is a background scheduler — no port exposed
CMD ["python", "-m", "src.quality.engine"]
