#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "elastic" ]]; then shift; exec python -m packages.elastic_store.cli "$@"; fi
if [[ "${1:-}" == "scanner" ]]; then shift; exec python -m services.scanner_worker.cli "$@"; fi
echo "usage: dataobs elastic {plan|apply|status|rollback} | dataobs scanner {run|test-connection|discover|scan-once|print-capabilities}" >&2; exit 2
