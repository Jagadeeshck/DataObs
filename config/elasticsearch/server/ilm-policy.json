{
  "_meta": {
    "description": "DataObs server-side ILM policy — hot 7d, warm 30d, cold 90d, delete 365d"
  },
  "phases": {
    "hot": {
      "min_age": "0ms",
      "actions": {
        "rollover": {
          "max_primary_shard_size": "40gb",
          "max_age": "7d"
        },
        "set_priority": {
          "priority": 100
        }
      }
    },
    "warm": {
      "min_age": "7d",
      "actions": {
        "shrink": {
          "number_of_shards": 1
        },
        "forcemerge": {
          "max_num_segments": 1
        },
        "set_priority": {
          "priority": 50
        },
        "allocate": {
          "require": {
            "_tier_preference": "data_warm"
          }
        }
      }
    },
    "cold": {
      "min_age": "30d",
      "actions": {
        "set_priority": {
          "priority": 0
        },
        "allocate": {
          "require": {
            "_tier_preference": "data_cold"
          }
        }
      }
    },
    "delete": {
      "min_age": "365d",
      "actions": {
        "delete": {}
      }
    }
  }
}
