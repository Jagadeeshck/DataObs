{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "external",
    "telemetry",
    "api",
    "console",
    "qualityWorker",
    "scannerWorker",
    "monitorRuntime",
    "pathwayWorker",
    "kafkaObserver",
    "otelCollector",
    "migrationJob",
    "networkPolicy"
