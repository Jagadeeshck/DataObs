            "captureResourceSummary": {
              "type": "boolean"
            },
            "propagateTraceHeaders": {
              "type": "boolean"
            },
            "tracePropagationAllowlist": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 16
            },
            "diagnosticsEnabled": {
              "type": "boolean"
            },
            "debug": {
              "type": "boolean"
            },
            "exportIntervalMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 60000
            },
            "maxQueuedSpans": {
              "type": "integer",
              "minimum": 16,
              "maximum": 2048
            },
            "maxQueuedMetrics": {
              "type": "integer",
              "minimum": 16,
              "maximum": 2048
