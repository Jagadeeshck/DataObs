                "allowedHeaders": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exposedHeaders": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "allowCredentials": {
                  "type": "boolean"
                },
                "maxAge": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400
