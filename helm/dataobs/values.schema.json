  "definitions": {
    "resources": {
      "type": "object",
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(m)?$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "external": {
      "type": "object",
      "required": [
        "elasticsearch",
        "oidc"
      ],
      "properties": {
        "elasticsearch": {
          "type": "object",
          "required": [
            "url",
            "secretName",
            "usernameKey",
            "passwordKey",
            "caKey",
            "verifyCertificates"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://.+"
            },
            "secretName": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "usernameKey": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            },
            "verifyCertificates": {
              "type": "boolean"
            }
          }
        },
        "oidc": {
          "type": "object"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "bundled",
            "external"
          ]
        },
        "endpoint": {
          "type": "string"
        },
        "protocol": {
          "enum": [
            "grpc",
            "http/protobuf"
          ]
        },
        "tls": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object"
    },
    "api": {
      "type": "object",
      "required": [
        "enabled",
        "replicaCount",
        "image",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._/-]*$"
            },
            "tag": {
              "type": "string",
              "pattern": "^(?!latest$)(?:[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?|[0-9a-f]{7,64})$"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[0-9a-f]{64}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "$ref": "#/definitions/resources"
            },
            "limits": {
              "$ref": "#/definitions/resources"
            }
