{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "external",
    "telemetry",
    "api",
    "console",
    "qualityWorker",
    "scannerWorker",
    "monitorRuntime",
    "pathwayWorker",
    "kafkaObserver",
    "otelCollector",
    "migrationJob",
    "networkPolicy",
    "monitoring"
  ],
  "definitions": {
    "resources": {
      "type": "object",
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(m)?$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$"
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "external": {
      "type": "object",
      "required": [
        "elasticsearch",
        "oidc"
      ],
      "properties": {
        "elasticsearch": {
          "type": "object",
          "required": [
            "url",
            "secretName",
            "usernameKey",
            "passwordKey",
            "caKey",
            "verifyCertificates"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://.+"
            },
            "secretName": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "usernameKey": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            },
            "verifyCertificates": {
              "type": "boolean"
            },
            "caSecretName": {
              "type": "string",
              "minLength": 1
            },
            "fingerprintSecretName": {
              "type": "string",
              "minLength": 1
            },
            "fingerprintKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "oidc": {
          "type": "object"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "bundled",
            "external"
          ]
        },
        "endpoint": {
          "type": "string"
        },
        "protocol": {
          "enum": [
            "grpc",
            "http/protobuf"
          ]
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled",
            "caSecretName",
            "caKey",
            "clientSecretName",
            "authHeaderSecretName",
            "authHeaderSecretKey"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "caSecretName": {
              "type": "string"
            },
            "caKey": {
              "type": "string"
            },
            "clientSecretName": {
              "type": "string"
            },
            "authHeaderSecretName": {
              "type": "string"
            },
            "authHeaderSecretKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "enabled": {
          "type": "boolean"
        },
        "exportTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "queueSize": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "traceSampleRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metricExportIntervalMs": {
          "type": "integer",
          "minimum": 1000
        },
        "logCorrelation": {
          "type": "boolean"
        },
        "environment": {
          "type": "string"
        },
        "releaseSha": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "endpoint",
        "protocol",
        "exportTimeoutMs",
        "queueSize",
        "batchSize",
        "traceSampleRatio",
        "metricExportIntervalMs",
        "logCorrelation",
        "environment",
        "releaseSha",
        "tls"
      ]
    },
