          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "serviceName",
            "serviceVersion",
            "deploymentEnvironment",
            "otlpHttpEndpoint",
            "traceSampleRatio",
            "exportIntervalMs",
            "maxQueuedSpans",
            "maxQueuedMetrics"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serviceName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "serviceVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "deploymentEnvironment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
