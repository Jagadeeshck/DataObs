# ─────────────────────────────────────────────────────────────────────────────
# Grafana Cloud credentials
# Copy this file to .env and fill in your real values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Found at: Grafana Cloud → stack → OpenTelemetry → Configure
# Format: https://otlp-gateway-prod-<region>.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp

# Your numeric Grafana Cloud stack / instance ID
# Found at: Grafana Cloud → stack → OpenTelemetry → Configure → Instance ID
GRAFANA_CLOUD_INSTANCE_ID=123456

# A Grafana Cloud API key (service account token) with these scopes:
#   metrics:write  logs:write  traces:write
# Found at: Grafana Cloud → Security → API Keys → Add API key
GRAFANA_CLOUD_API_KEY=glc_eyJxxxxxxxxxxx==

# ─────────────────────────────────────────────────────────────────────────────
# Application settings (optional overrides)
# ─────────────────────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=sample-python-app
SERVICE_VERSION=1.0.0
DEPLOYMENT_ENVIRONMENT=development
